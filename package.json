{
  "name": "internet-performance-tester",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,engine -c cyan,magenta --kill-others-on-fail \"npm:dev:web\" \"npm:engine:watch\"",
    "dev:web": "next dev -H 127.0.0.1 -p 3000",
    "engine": "tsx engine/main.ts",
    "engine:watch": "tsx watch --clear-screen=false engine/main.ts",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "start:all": "concurrently -n web,engine -c cyan,magenta --restart-tries -1 --restart-after 3000 \"npm:start\" \"npm:engine\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide-react": "^1.54.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
